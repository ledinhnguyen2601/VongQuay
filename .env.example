# Cổng máy chủ cục bộ
PORT=3000

# Môi trường chạy: development | production
NODE_ENV=development

# Khóa bí mật ký JWT (BẮT BUỘC tối thiểu 32 ký tự ngẫu nhiên trong production)
JWT_SECRET=your_random_jwt_secret_at_least_32_characters

# Tên miền được phép truy cập CORS (phân tách bằng dấu phẩy)
CORS_ORIGIN=http://localhost:3000

# Địa chỉ công khai gốc của website (bắt buộc khi production)
PUBLIC_BASE_URL=https://vong-quay-kappa.vercel.app

# API Key ImgBB (dùng từ server để tải ảnh logo/nền, lấy tại https://api.imgbb.com)
IMGBB_API_KEY=your_imgbb_api_key_here

# Cấu hình Firebase Realtime Database
# Cách 1 (Khuyên dùng trên Vercel): Chuỗi Base64 của file serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Cách 2 (Dùng cục bộ): Đường dẫn tới file JSON
FIREBASE_SERVICE_ACCOUNT_PATH=
# URL Realtime Database (ví dụ: https://your-project-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=
