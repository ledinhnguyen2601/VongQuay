# Cổng máy chủ
PORT=3000

# Môi trường chạy: development | production
NODE_ENV=development

# Khóa bí mật ký JWT (BẮT BUỘC >= 32 ký tự ngẫu nhiên)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_lucky_wheel_saas_2026_secure

# Tên miền được phép truy cập CORS (dấu phẩy nếu nhiều domain, ví dụ: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# API Key ImgBB (dùng từ server để tải ảnh logo/nền, lấy tại https://api.imgbb.com)
IMGBB_API_KEY=your_imgbb_api_key_here

# Cấu hình Firebase Realtime Database (Tùy chọn khi dev - nếu để trống sẽ tự động dùng In-Memory Store)
# Đường dẫn tới file Service Account JSON (tải từ Firebase Console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=
# URL Realtime Database (ví dụ: https://your-project-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=
